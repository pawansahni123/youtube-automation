# --- API Keys (copy this file to .env and fill in your real keys) ---

# Google Cloud Console -> YouTube Data API v3 key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google AI Studio -> Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Your channel's niche (used to search/filter topics)
NICHE_KEYWORDS=psychology facts,mystery facts,mind-blowing facts

# Target region for trending search (US = United States)
REGION_CODE=US
